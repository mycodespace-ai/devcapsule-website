<aside class="docs-sidebar docs-sidebar-left">
  <button type="button" class="docs-nav-toggle" aria-expanded="false" aria-controls="docs-primary-nav" hidden>
    <span class="docs-nav-toggle-meta">Docs {{ entry.version.label }}</span>
    <span class="docs-nav-toggle-title">{{ entry.title }}</span>
    <span class="docs-nav-toggle-icon" aria-hidden="true">▾</span>
  </button>
  <nav id="docs-primary-nav" aria-label="Documentation {{ entry.version.label }}">
    <span class="eyebrow">Start here</span>
    {% for item in entry.sidebar.start %}<a href="{{ item.url | url }}" {% if item.path == entry.path %}aria-current="page"{% endif %} {% if item.planned %}class="planned"{% endif %}>{{ item.title }}{% if item.planned %} <span class="soon">soon</span>{% endif %}</a>{% endfor %}
    {% for area in entry.sidebar.areas %}<details class="sidebar-area" {% for item in area.pages %}{% if item.path == entry.path %}open{% endif %}{% endfor %}><summary>{{ area.title }}</summary>{% for item in area.pages %}<a href="{{ item.url | url }}" {% if item.path == entry.path %}aria-current="page"{% endif %} {% if item.planned %}class="planned"{% endif %}>{{ item.title }}{% if item.planned %} <span class="soon">soon</span>{% endif %}</a>{% endfor %}</details>{% endfor %}
    {% if entry.sidebar.background.length %}<details class="sidebar-area sidebar-background" {% if entry.historical %}open{% endif %}><summary>Background &amp; earlier material</summary>{% for item in entry.sidebar.background %}<a href="{{ item.url | url }}" {% if item.path == entry.path %}aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}</details>{% endif %}
    <a class="sidebar-source" href="{{ '/docs/' | url }}">All documentation versions</a>
  </nav>
</aside>
